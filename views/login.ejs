<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>POS | Iniciar sesión</title>

    <link rel="shortcut icon" href="/images/favicon.webp" type="image/webp">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body class="auth-page">

    <main class="auth-container">

        <section class="auth-card login-card">

            <div class="auth-logo">
                <img src="/images/logo.webp" alt="Logo del POS" class="auth-logo-image">
            </div>

            <form method="POST" action="/login" class="auth-form login-form">

                <h1 class="auth-title">
                    Iniciar sesión
                </h1>

                <% if (message) { %>
                    <div class="auth-message" role="alert">
                        <%= message %>
                    </div>
                    <% } %>

                        <div class="auth-fields">

                            <div class="form-field">

                                <label for="user" class="form-label">
                                    Usuario
                                </label>

                                <input id="user" name="user" type="text" class="form-input" autocomplete="username"
                                    autofocus required>

                            </div>

                            <div class="form-field">

                                <label for="pass" class="form-label">
                                    Contraseña
                                </label>

                                <input id="pass" name="pass" type="password" class="form-input"
                                    autocomplete="current-password" required>

                            </div>

                        </div>

                        <div class="auth-actions">

                            <button type="submit" class="auth-button auth-button-primary">
                                Entrar
                            </button>

                            <a href="/register" class="auth-button auth-button-secondary">
                                Registrar
                            </a>

                        </div>

            </form>

        </section>

    </main>

</body>

</html>