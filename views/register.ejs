<!DOCTYPE html>
<html lang="es">

<head>
    <title>POS</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8">

    <link rel="shortcut icon" href="/images/favicon.webp" type="icon/webp" sizes="32x32">

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/register.css">
</head>

<body class="auth-register-page">

    <main class="auth-register-wrapper">

        <section class="auth-register-card">

            <div class="auth-register-brand">

                <div class="auth-logo-frame">

                    <div class="auth-logo-glow"></div>

                    <img src="/images/logo.png" alt="POS">

                </div>

            </div>

            <div class="auth-register-header">

                <h1>REGISTRARSE</h1>

                <p>
                    Complete los datos para crear una cuenta
                </p>

            </div>

            <div class="auth-message">

                <% if (message) { %>

                    <div class="auth-message-error">

                        <span class="auth-message-icon">
                            !
                        </span>

                        <span class="auth-message-text">
                            <%= message %>
                        </span>

                    </div>

                    <% } %>

            </div>

            <form method="POST" action="/register" class="auth-register-form">

                <div class="auth-register-fields">

                    <div class="auth-field">

                        <label for="name" class="auth-field-label">
                            Nombre completo
                            <span class="auth-required">*</span>
                        </label>

                        <input id="name" name="name" type="text" class="auth-field-input" autocomplete="name" autofocus>

                    </div>

                    <div class="auth-field">

                        <label for="user" class="auth-field-label">
                            Usuario
                            <span class="auth-required">*</span>
                        </label>

                        <input id="user" name="user" type="text" class="auth-field-input" autocomplete="username">

                    </div>

                    <div class="auth-field">

                        <label for="job_name" class="auth-field-label">
                            Cargo
                            <span class="auth-required">*</span>
                        </label>

                        <select id="job_name" name="job_name" class="auth-field-select">

                            <option value="" hidden selected>
                                Selecciona una opción
                            </option>

                            <option value="1">
                                Administrador/a
                            </option>

                            <option value="2">
                                Contador/a
                            </option>

                            <option value="3">
                                Empleado/a
                            </option>

                        </select>

                    </div>

                    <div class="auth-field">

                        <label for="pass" class="auth-field-label">
                            Contraseña
                            <span class="auth-required">*</span>
                        </label>

                        <div class="auth-password-wrapper">

                            <input id="pass" name="pass" type="password" class="auth-field-input auth-password-input"
                                autocomplete="new-password">

                            <button type="button" class="auth-password-toggle" id="togglePassShow"
                                aria-label="Mostrar contraseña" title="Mostrar contraseña">

                                <svg class="auth-password-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.1 12s3.2-5.5 9.9-5.5S21.9 12 21.9 12s-3.2 5.5-9.9 5.5S2.1 12 2.1 12Z"
                                        fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                        stroke-linejoin="round" />

                                    <circle cx="12" cy="12" r="2.8" fill="none" stroke="currentColor"
                                        stroke-width="1.8" />
                                </svg>

                            </button>

                        </div>

                    </div>

                </div>

                <div class="auth-actions">

                    <button type="submit" class="auth-action auth-action-primary">
                        registrar
                    </button>

                    <a href="/login" class="auth-action auth-action-secondary">
                        ➦ atras
                    </a>

                </div>

            </form>

        </section>

    </main>

    <script src="/js/revealPass.js"></script>

</body>

</html>