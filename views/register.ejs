<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS | Registrarse</title>
    <link rel="shortcut icon" href="/images/favicon.webp" type="image/webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/register.css">
</head>

<body class="auth-page">
    <main class="auth-container">
        <section class="auth-card register-card">
            <div class="auth-logo"> <img src="/images/logo.webp" alt="Logo del POS" class="auth-logo-image"> </div>
            <form method="POST" action="/register" class="auth-form register-form">
                <h1 class="auth-title"> Registrarse </h1>
                <% if (message) { %>
                    <div class="auth-message" role="alert">
                        <%= message %>
                    </div>
                    <% } %>
                        <div class="auth-fields">
                            <div class="form-field"> <label for="name" class="form-label"> Nombre completo <span
                                        class="required-mark" aria-hidden="true">*</span> </label> <input id="name"
                                    name="name" type="text" class="form-input" autocomplete="name" autofocus required>
                            </div>
                            <div class="form-field"> <label for="user" class="form-label"> Usuario <span
                                        class="required-mark" aria-hidden="true">*</span> </label> <input id="user"
                                    name="user" type="text" class="form-input" autocomplete="username" required> </div>
                            <div class="form-field"> <label for="job_name" class="form-label"> Cargo <span
                                        class="required-mark" aria-hidden="true">*</span> </label> <select id="job_name"
                                    name="job_name" class="form-input form-select" required>
                                    <option value="" selected disabled> Selecciona una opción </option>
                                    <option value="1"> Administrador/a </option>
                                    <option value="2"> Contador/a </option>
                                    <option value="3"> Empleado/a </option>
                                </select> </div>
                            <div class="form-field"> <label for="pass" class="form-label"> Contraseña <span
                                        class="required-mark" aria-hidden="true">*</span> </label> <input id="pass"
                                    name="pass" type="password" class="form-input" autocomplete="new-password" required>
                            </div>
                        </div>
                        <div class="auth-actions"> <button type="submit" class="auth-button auth-button-secondary">
                                Registrar </button> <a href="/login" class="auth-button auth-button-primary"> Atrás </a>
                        </div>
            </form>
        </section>
    </main>
</body>

</html>